; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Echoes of Eleven"
config/description="A story-driven detective game with action-thriller sequences"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
SceneManager="*res://scripts/autoload/scene_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
ClueManager="*res://scripts/autoload/clue_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Achievements="*res://scripts/autoload/achievements.gd"
DetectiveNotebook="*res://scripts/autoload/detective_notebook.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

