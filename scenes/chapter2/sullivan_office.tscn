text = "[E] Examine"

# 5. Mystery Key — on the desk (collect last)
[node name="MysteryKey" type="Area3D" parent="Clues"]
position = Vector3(0.3, 0.87, -2.1)
script = ExtResource("5_clue")
clue_id = "mystery_key"
clue_display_name = "Unmarked Key"
examine_text = "A small, unmarked key. The tag has been removed but you can make out a partial stamp: 'NDRS L47'. New Delhi Railway Station, Locker 47. What did Sullivan hide there?"
