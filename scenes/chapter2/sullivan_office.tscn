# CLUES ─────────────────────────────────────────────────────────
[node name="Clues" type="Node3D" parent="."]

# 1. Business Contract — on desk
[node name="BusinessContract" type="Area3D" parent="Clues"]
position = Vector3(-0.8, 0.86, -2.8)
script = ExtResource("5_clue")
clue_id = "business_contract"
clue_display_name = "Disputed Business Contract"
examine_text = "A partnership contract between Marcus Sullivan and Arjun Mehta. Handwritten 'VOID' scrawled across the last page — but the signature is unmistakably Arjun's. Why would he void his own contract?"
[node name="MeshInstance3D" type="MeshInstance3D" parent="Clues/BusinessContract"]
mesh = SubResource("BoxMesh_clue")
surface_material_override/0 = SubResource("Mat_document")
[node name="CollisionShape3D" type="CollisionShape3D" parent="Clues/BusinessContract"]
shape = SubResource("BoxShape3D_clue")
[node name="Label3D" type="Label3D" parent="Clues/BusinessContract"]
position = Vector3(0, 0.3, 0)
pixel_size = 0.005
text = "[E] Examine"

# 2. Insurance Policy — in the safe behind the painting
[node name="InsurancePolicy" type="Area3D" parent="Clues"]
position = Vector3(5.0, 2.0, -5.7)
script = ExtResource("5_clue")
clue_id = "insurance_policy"
clue_display_name = "Life Insurance Policy"
examine_text = "A Rs. 2 crore life insurance policy on Arjun Mehta. Beneficiary: Marcus Sullivan. The policy was taken out exactly 90 days before the murder. Someone was planning ahead."
[node name="MeshInstance3D" type="MeshInstance3D" parent="Clues/InsurancePolicy"]
mesh = SubResource("BoxMesh_safe")
surface_material_override/0 = SubResource("Mat_safe")
[node name="CollisionShape3D" type="CollisionShape3D" parent="Clues/InsurancePolicy"]
shape = SubResource("BoxShape3D_clue")
[node name="Label3D" type="Label3D" parent="Clues/InsurancePolicy"]
position = Vector3(0, 0.3, 0)
pixel_size = 0.005
text = "[E] Open Safe"

# 3. Marcus Office Intro document — on a side table
[node name="OfficeLetter" type="Area3D" parent="Clues"]
position = Vector3(0.8, 0.86, -2.3)
script = ExtResource("5_clue")
clue_id = "marcus_office_intro"
clue_display_name = "DA's Subpoena Letter"
examine_text = "A sealed forensic letter from the DA's office. Sullivan was subpoenaed for phone records tied to Arjun Mehta's case. He received this three days ago — yet he claimed ignorance of any police interest."
[node name="MeshInstance3D" type="MeshInstance3D" parent="Clues/OfficeLetter"]
mesh = SubResource("BoxMesh_clue")
surface_material_override/0 = SubResource("Mat_document")
[node name="CollisionShape3D" type="CollisionShape3D" parent="Clues/OfficeLetter"]
shape = SubResource("BoxShape3D_clue")
[node name="Label3D" type="Label3D" parent="Clues/OfficeLetter"]
position = Vector3(0, 0.3, 0)
pixel_size = 0.005
text = "[E] Examine"

# 4. Parking Receipt — in a coat hung on a rack
[node name="ParkingReceipt" type="Area3D" parent="Clues"]
position = Vector3(-4, 1.2, 2.5)
script = ExtResource("5_clue")
clue_id = "parking_receipt"
clue_display_name = "Parking Receipt"
examine_text = "A crumpled parking receipt from Vasant Vihar. Timestamp: 11:31 PM, the night of the murder. Vasant Vihar is two blocks from Arjun's apartment. Sullivan said he was at Crown Plaza restaurant. He lied."
[node name="MeshInstance3D" type="MeshInstance3D" parent="Clues/ParkingReceipt"]
